/* =====================================================
   상태
===================================================== */

let currentQuestion = 0;

let scores = {
    E:0, I:0,
    S:0, N:0,
    T:0, F:0,
    J:0, P:0
};


/* =====================================================
   화면
===================================================== */

function showScreen(id) {

    document.querySelectorAll(".screen").forEach(
        screen => screen.classList.remove("active")
    );

    document.getElementById(id)
        .classList.add("active");

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =====================================================
   시작
===================================================== */

function startTest() {

    currentQuestion = 0;

    scores = {
        E:0, I:0,
        S:0, N:0,
        T:0, F:0,
        J:0, P:0
    };

    showScreen("quiz-screen");

    showQuestion();
}


/* =====================================================
   질문 표시
===================================================== */

function showQuestion() {

    const q = questions[currentQuestion];

    document.getElementById("question-number")
        .textContent = "Q" + (currentQuestion + 1);

    document.getElementById("current-number")
        .textContent = currentQuestion + 1;

    document.getElementById("question-category")
        .textContent = q.category;

    document.getElementById("question-text")
        .textContent = q.text;


    const progress =
        (currentQuestion / questions.length) * 100;

    document.getElementById("progress-fill")
        .style.width = progress + "%";


    const answerArea =
        document.getElementById("answers");

    answerArea.innerHTML = "";


    q.answers.forEach((answer,index) => {

        const button =
            document.createElement("button");

        button.className = "answer";

        button.innerHTML =
            `<span class="answer-number">${index+1}</span>
             ${answer.text}`;

        button.onclick = () => {
            chooseAnswer(answer);
        };

        answerArea.appendChild(button);

    });
}


/* =====================================================
   선택
===================================================== */

function chooseAnswer(answer) {

    Object.entries(answer.score).forEach(
        ([type,value]) => {

            scores[type] += value;

        }
    );


    currentQuestion++;


    if(currentQuestion < questions.length) {

        showQuestion();

    } else {

        showResult();

    }
}


/* =====================================================
   MBTI 계산
===================================================== */

function calculateMBTI() {

    let mbti = "";

    mbti +=
        scores.E >= scores.I ? "E" : "I";

    mbti +=
        scores.S >= scores.N ? "S" : "N";

    mbti +=
        scores.T >= scores.F ? "T" : "F";

    mbti +=
        scores.J >= scores.P ? "J" : "P";

    return mbti;
}


/* =====================================================
   점수 막대
===================================================== */

function setScoreBar(elementId, left, right) {

    const total = left + right;

    let percent = 50;

    if(total > 0) {

        percent =
            (left / total) * 100;

    }

    document.getElementById(elementId)
        .style.width = percent + "%";
}


/* =====================================================
   결과
===================================================== */

function showResult() {

    const mbti = calculateMBTI();

    const result = results[mbti];


    document.getElementById("result-mbti")
        .textContent = mbti;

    document.getElementById("result-name")
        .textContent = result.name;

    document.getElementById("result-description")
        .textContent = result.description;


    /* 판다 이미지 */

    const panda =
        document.getElementById("panda-sprite");

    panda.className =
        "panda-sprite " + mbti;


    /* 태그 */

    const tagArea =
        document.getElementById("result-tags");

    tagArea.innerHTML = "";

    result.tags.forEach(tag => {

        const span =
            document.createElement("span");

        span.className = "tag";

        span.textContent =
            "#" + tag;

        tagArea.appendChild(span);

    });


    /* 성향 점수 */

    setScoreBar(
        "ei-bar",
        scores.E,
        scores.I
    );

    setScoreBar(
        "sn-bar",
        scores.S,
        scores.N
    );

    setScoreBar(
        "tf-bar",
        scores.T,
        scores.F
    );

    setScoreBar(
        "jp-bar",
        scores.J,
        scores.P
    );


    showScreen("result-screen");
}


/* =====================================================
   다시 하기
===================================================== */

function restartTest() {

    startTest();

}


/* =====================================================
   처음으로
===================================================== */

function goHome() {

    currentQuestion = 0;

    scores = {
        E:0, I:0,
        S:0, N:0,
        T:0, F:0,
        J:0, P:0
    };

    showScreen("start-screen");

}

